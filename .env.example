# =============================================================================
# Local development environment — copy to .env and fill in values
# NEVER commit .env to source control
# =============================================================================

# ── JWT ───────────────────────────────────────────────────────────────────────
# Min 32 characters, random. Generate with: openssl rand -base64 32
JWT_SECRET_KEY=replace-with-at-least-32-character-random-string
JWT_ISSUER=https://localhost:7100
JWT_AUDIENCE=https://localhost:7200
JWT_EXPIRY_MINUTES=60

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# Redirect URI: https://localhost:7100/api/v1/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook OAuth ────────────────────────────────────────────────────────────
# Create at https://developers.facebook.com → My Apps → Add a New App
# Redirect URI: https://localhost:7100/api/v1/auth/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Admin accounts ────────────────────────────────────────────────────────────
# Comma-separated email addresses that receive the Admin role on first login
ADMIN_SEED_EMAILS=your@email.com

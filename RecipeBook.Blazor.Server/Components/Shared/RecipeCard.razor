@using RecipeBook.Application.DTOs

<MudCard Class="mb-4" hoverable="true" click="@(() => HandleClick())">
    <MudCardContent>
        @if (Recipe != null)
        {
            <MudText Typo="Typo.h6">@Recipe.Title</MudText>
            <MudText Class="mt-1" Style="font-size: 0.875rem;">@Recipe.Category</MudText>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public RecipeSummaryDto? Recipe { get; set; }
    [Parameter] public EventCallback<RecipeSummaryDto> OnClick { get; set; }

    private async Task HandleClick()
    {
        if (Recipe != null)
            await OnClick.InvokeAsync(Recipe);
    }
}

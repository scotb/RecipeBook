@page "/"
@inject IDemoAuthService DemoAuth
@inject IAuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Home</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudAlert Severity="Severity.Info" Class="mb-4">
        <MudText Typo="Typo.h5">RecipeBook</MudText>
        <MudText> A recipe management app. Sign in to get started.</MudText>
    </MudAlert>

#if DEBUG
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleDemoLogin"
               Disabled="@isLoggingIn" Class="w-100">
        @if (isLoggingIn)
        {
            <MudProgressCircular Indeterminate="true" Class="mr-2" />
        }
        Login as Demo User
    </MudButton>
#endif
</MudContainer>

@code {
    private bool isLoggingIn;

    private async Task HandleDemoLogin()
    {
        isLoggingIn = true;
        try
        {
            var token = await DemoAuth.LoginAsDemoAsync();
            await AuthState.SetUser(token);
            Navigation.NavigateTo("/catalog");
        }
        finally
        {
            isLoggingIn = false;
        }
    }
}
